<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.12.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>io.github.dengmeiluan</groupId>
    <artifactId>searchdeck</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>SearchDeck</name>
    <description>Embeddable Elasticsearch operations platform: platform kernel, console,
        standalone server and host integrations.</description>
    <url>https://github.com/dengmeiluan/searchdeck</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>dengmeiluan</id>
            <name>Meiluan Deng</name>
            <url>https://github.com/dengmeiluan</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/dengmeiluan/searchdeck</url>
        <connection>scm:git:git://github.com/dengmeiluan/searchdeck.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/dengmeiluan/searchdeck.git</developerConnection>
    </scm>

    <modules>
        <module>platform</module>
        <module>modules/console</module>
        <module>apps/server</module>
        <module>integrations/quotehub</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <forkCount>4</forkCount>
        <console.build.skip>false</console.build.skip>
    </properties>

    <profiles>
        <profile>
            <id>npm-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm.cmd</npm.executable>
            </properties>
        </profile>
        <profile>
            <id>npm-unix</id>
            <activation>
                <os>
                    <family>!windows</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm</npm.executable>
            </properties>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <failOnError>false</failOnError>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <searchdeck.root>${maven.multiModuleProjectDirectory}</searchdeck.root>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
