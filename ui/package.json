{
  "name": "@esquerystudio/ui",
  "private": true,
  "version": "1.0.13",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --config vite.demo.config.ts",
    "test": "node scripts/test-parallel.mjs",
    "test:serial": "vitest run",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "perm:scan": "node scripts/perm-scan.mjs",
    "perm:matrix": "node scripts/perm-matrix.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^0.469.0",
    "monaco-editor": "0.52.2",
    "naive-ui": "2.43.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.45",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  },
  "description": "ESQueryStudio console — embeddable Elasticsearch operations platform",
